# =============================================================================
# Copy to .env.local for local development. On Vercel, set these under
# Project → Settings → Environment Variables (Production + Preview).
# Variables marked [phase N] are only required once that phase ships.
# NEXT_PUBLIC_* values are exposed to the browser; everything else is server-only.
# =============================================================================

# --- App ---------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_BRAND_NAME="Coastal Swim Co."
# Shared secret for Vercel Cron → /api/cron/* (offer expiry, reminders, webhook retries) [phase 2+]
CRON_SECRET=

# --- Supabase ----------------------------------------------------------------
# Local: printed by `supabase start` (API URL + anon key + service_role key).
# Hosted: Project Settings → API. The publishable key also works as the anon key.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Google sign-in (used by Supabase Auth; also enter in Supabase dashboard → Auth → Providers → Google)
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# RLS test suite target (see README → Testing). Never point at production.
TEST_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/swim_test

# --- Stripe [phase 3] --------------------------------------------------------
# Local development without Stripe: set PAYMENTS_DEV_MODE=true and leave
# STRIPE_SECRET_KEY empty — checkout becomes a simulated page (/dev/checkout).
# Ignored in production builds.
PAYMENTS_DEV_MODE=false
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
# From `stripe listen --forward-to localhost:3000/api/webhooks/stripe` or the dashboard endpoint
STRIPE_WEBHOOK_SECRET=
# Customer Portal configuration id (optional; default portal config is used if empty)
STRIPE_PORTAL_CONFIGURATION_ID=

# --- Google Maps [phase 3] ---------------------------------------------------
# Browser key: restrict to your domains (HTTP referrers) + Places API (New) + Maps JavaScript API.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Server key: restrict by API (Geocoding, Places, Routes). Used to verify addresses and zones server-side.
GOOGLE_MAPS_SERVER_API_KEY=

# --- Twilio (text messages) [phase 4] ------------------------------------------
# Leave empty to only log texts (Admin → Messages). Register for A2P 10DLC before launch.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=

# --- Resend (email) [phase 4] ------------------------------------------------
# Leave empty to only log emails (Admin → Messages).
RESEND_API_KEY=
EMAIL_FROM="Coastal Swim Co. <lessons@example.com>"
# Where flagged-message alerts and day-pass inquiries are sent
ADMIN_ALERT_EMAIL=owner@example.com

# --- Google Calendar sync [phase 6] -----------------------------------------
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
# 32-byte base64 key used to encrypt stored OAuth refresh tokens (openssl rand -base64 32)
TOKEN_ENCRYPTION_KEY=
